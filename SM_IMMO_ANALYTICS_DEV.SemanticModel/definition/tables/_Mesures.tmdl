		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Comparaison temporelle
		lineageTag: e2e95fe7-c1cc-486e-b1c3-35864c57cc0d

	measure 'Nb Reservations' =
			
			DISTINCTCOUNT ( fact_reservation[reservation_id] )
		formatString: 0
		lineageTag: de80f6b9-a81e-456b-9b9f-930d34b5f22f

	/// P1-2 : une réservation n'est convertie que si la vente est valide.
	measure 'Nb Reservations Converties' =
			VAR ReservationsSelectionnees =
			    VALUES ( fact_reservation[reservation_id] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( fact_vente[reservation_id] ),
			        REMOVEFILTERS ( dim_date ),
			        TREATAS ( ReservationsSelectionnees, fact_vente[reservation_id] ),
			        KEEPFILTERS ( NOT fact_vente[statut_vente] IN { "ANNULEE", "ECHEC", "ABANDONNE" } )
			    )
		formatString: 0
		lineageTag: 56c3fe13-0ca7-49c1-b1f9-ae5fad590ff6

	measure 'Taux Transformation' = DIVIDE ( [Nb Reservations Converties], [Nb Reservations] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: réservations
		lineageTag: 86500fac-192c-4621-8528-f08075e0f233

	measure 'Taux Transformation M-1' =
			IF (
			    COUNTROWS ( VALUES ( dim_date[annee_mois_key] ) ) = 1,
			    CALCULATE ( [Taux Transformation], DATEADD ( dim_date[full_date], -1, MONTH ) )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Comparaison temporelle
		lineageTag: 8d927dcf-fc7c-4291-95a0-80ae27704336

	measure 'Variation Transformation M-1' = ( [Taux Transformation] - [Taux Transformation M-1] ) * 100
		formatString: +0.0" pts";-0.0" pts";0.0" pts"
		displayFolder: réservations
		lineageTag: 45ba5c41-807a-4f55-bdb6-fcb6fc483f2d

	measure 'Nb Reservations Annulees' =
			
			CALCULATE (
			    DISTINCTCOUNT ( fact_reservation[reservation_id] ),
			    NOT ISBLANK ( fact_reservation[date_annulation_key] )
			)
		formatString: 0
		lineageTag: 49ab8e76-ab41-45e8-8440-f1e468180f7f

	measure 'Taux Annulation' = DIVIDE ( [Nb Reservations Annulees], [Nb Reservations] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: réservations
		lineageTag: 0811d057-9dcd-4594-88d5-270d5206a699


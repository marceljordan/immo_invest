		formatString: 0
		lineageTag: 1da982c7-011f-4126-952c-7f0991889994

	measure 'Nb Ventes M-1' =
			IF (
			    COUNTROWS ( VALUES ( dim_date[annee_mois_key] ) ) = 1,
			    CALCULATE ( [Nb Ventes], DATEADD ( dim_date[full_date], -1, MONTH ) )
			)

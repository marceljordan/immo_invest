table _Mesures
	lineageTag: ca3b12d4-cab6-4349-a031-752a4ccb7de3

	measure 'CA TTC' =
			CALCULATE (
			    SUM ( fact_vente[prix_vente_ttc] ),
			    KEEPFILTERS ( fact_vente[is_vente_valide] = 1 )
			)
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: ventes
		lineageTag: 167de2c4-1cfd-4f78-893d-9ddd3f91f153

	/// P1-2 : même filtre que CA TTC.
	measure 'Nb Ventes' =
			CALCULATE (
			    COUNTROWS ( fact_vente ),
			    KEEPFILTERS ( NOT fact_vente[statut_vente] IN { "ANNULEE", "ECHEC", "ABANDONNE" } )
			)
		formatString: 0
		displayFolder: ventes
		lineageTag: af3b218c-8c74-40cf-ad9a-184180e097f8

	measure 'Panier Moyen' = DIVIDE ( [CA TTC], [Nb Ventes] )
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: ventes
		lineageTag: e9f81a58-d249-4b53-afbc-548572b810a1

	measure 'Objectif CA' =
			SWITCH (
			    [Niveau Objectif],
			    "CONSEILLER", [Objectif CA Conseiller],
			    "AGENCE",     [Objectif CA Agence],
			    "PARTENAIRE", [Objectif CA Partenaire],
			    [Objectif CA Région]
			)
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: objectifs
		lineageTag: 627114c1-1801-4f58-8ad8-b2c149186113

	measure 'Taux Atteinte' = DIVIDE ( [CA TTC], [Objectif CA] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: objectifs
		lineageTag: 1e505775-d14b-4aaf-9088-92931be9990d

	measure 'Ecart Objectif' = [CA TTC] - [Objectif CA]
		formatString: +#,0 €;-#,0 €;0 €
		displayFolder: objectifs
		lineageTag: 578c1ee1-d127-4e58-8e26-6eb0847bd748

	measure 'Ecart Objectif %' = DIVIDE ( [Ecart Objectif], [Objectif CA] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: objectifs
		lineageTag: 3a51f996-daf3-44aa-acd8-03670297fd6a

	measure 'CA TTC Barre' = [CA TTC]
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: _visuel
		lineageTag: b683e7fa-f26d-4a5f-863a-24131a20ba9a

	measure 'Rang Conseiller' =
			IF (
			    ( ISINSCOPE ( dim_conseiller[nom_complet] ) || ISINSCOPE ( dim_conseiller[conseiller_key] ) )
			        && NOT ISBLANK ( [CA TTC] ),
			    RANKX (
			        ALLSELECTED ( dim_conseiller[conseiller_key], dim_conseiller[nom_complet] ),
			        [CA TTC],
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: 0
		displayFolder: performance conseillers
		lineageTag: 489224c5-3d5e-4e3e-8079-ca053cc94061

	measure Médaille =
			
			SWITCH(
			    [Rang Conseiller],
			    1, "🥇",
			    2, "🥈",
			    3, "🥉",
			    BLANK()
			)
		lineageTag: 1b3921ee-c6c5-4ca4-a7ae-21c8a7801151

	measure 'Statut Code' = SELECTEDVALUE ( dim_statut[code_couleur], 0 )
		formatString: 0
		lineageTag: f78c164d-bfde-4a22-a626-7e3b6e905d6e

	measure 'Dernière actualisation' =
			VAR DateChargement =
			    CALCULATE (
			        MINX (
			            VALUES ( data_freshness[table_name] ),
			            CALCULATE ( MAX ( data_freshness[checked_at_paris] ) )
			        ),
			        data_freshness[table_schema] = "gold"
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( DateChargement ),
			        "Données au : " & FORMAT ( DateChargement, "dd/MM/yyyy HH:mm" )
			    )
		lineageTag: 70baec14-f8b2-4ba2-9d72-277a7d850e67

	measure 'CA N-1' =
			CALCULATE (
			    [CA TTC],
			    SAMEPERIODLASTYEAR ( dim_date[full_date] )
			)
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: Comparaison temporelle
		lineageTag: 6da3123a-6bc3-46a0-9200-90382a9a305c

	measure 'Variation CA' = [CA TTC] - [CA N-1]
		formatString: +#,0 €;-#,0 €;0 €
		displayFolder: Comparaison temporelle
		lineageTag: 9583b680-e541-421d-a874-eafdaf80d9d7

	measure 'Variation CA %' = DIVIDE ( [Variation CA], [CA N-1] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Comparaison temporelle
		lineageTag: fd73e70a-488d-4599-8a7a-f94a2067d2e0

	/// P1-3 : régions ayant au moins une agence ouverte à la fin de la période filtrée.
	measure 'Nb Régions Actives' =
			VAR FinPeriode =
			    MAX ( dim_date[full_date] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( dim_agence_region[region_id] ),
			        KEEPFILTERS ( dim_agence_region[date_ouverture] <= FinPeriode ),
			        KEEPFILTERS (
			            ISBLANK ( dim_agence_region[date_fermeture] )
			                || dim_agence_region[date_fermeture] > FinPeriode
			        )
			    )
		formatString: 0
		displayFolder: Régions & Agences
		lineageTag: 7be9b01d-fac8-4cc2-9e69-4764ed9ab520

	/// P1-3 : agences ouvertes (administrativement) à la fin de la période filtrée.
	/// Même définition qu'avant, mais datée : le N-1 fonctionne enfin.
	measure 'Nb Agences Actives' =
			VAR FinPeriode =
			    MAX ( dim_date[full_date] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( dim_agence_region[agence_id] ),
			        KEEPFILTERS ( dim_agence_region[date_ouverture] <= FinPeriode ),
			        KEEPFILTERS (
			            ISBLANK ( dim_agence_region[date_fermeture] )
			                || dim_agence_region[date_fermeture] > FinPeriode
			        )
			    )
		formatString: 0
		displayFolder: Régions & Agences
		lineageTag: 83428c6b-47b3-4030-8261-53bbd3087626

	measure 'Rang Agence CA' =
			IF (
			    ( ISINSCOPE ( dim_agence_region[nom_agence] ) || ISINSCOPE ( dim_agence_region[agence_region_key] ) )
			        && NOT ISBLANK ( [CA TTC] ),
			    RANKX (
			        ALLSELECTED ( dim_agence_region[agence_region_key], dim_agence_region[nom_agence] ),
			        [CA TTC],
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: 0
		displayFolder: Régions & Agences
		lineageTag: 8ae49550-6308-4823-931a-9628c35578f2

	measure 'Trimestre Libellé'
		lineageTag: e9f7e821-808e-47d5-99e2-41ccbd65d4df

	measure 'Nb Agences Actives N-1' =
			
			CALCULATE(
			    [Nb Agences Actives],
			    SAMEPERIODLASTYEAR(dim_date[full_date])
			)
		formatString: 0
		lineageTag: 807f244d-84ea-4cc1-b5df-780e2028c216

	measure 'Variation Nb Agences' =
			
			[Nb Agences Actives] - [Nb Agences Actives N-1]
		formatString: +0;-0;0
		lineageTag: abd22e6c-f35f-4bcd-846f-b36adb161666

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Taux Atteinte barre' = [Taux Atteinte]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: _visuel
		lineageTag: 1a5348a8-e3bf-44cd-b624-c62c8810b395

	/// P1-6 : seuils explicites. Valeurs à valider avec le métier.
	measure 'Statut Performance' =
			VAR Taux = [Taux Atteinte]
			VAR SeuilAtteint = 1.00
			VAR SeuilVigilance = 0.70
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Taux ), BLANK (),
			        Taux >= SeuilAtteint, "Atteint",
			        Taux >= SeuilVigilance, "À surveiller",
			        "En retard"
			    )
		displayFolder: performance conseillers
		lineageTag: 4f94532e-a5f1-476a-87b7-29ca7000fcdb

	measure 'Commissions Internes' = SUM ( fact_commission[part_commission_interne] )
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: commissions
		lineageTag: e765c302-a4db-40f3-a8f7-1ba9eef55628

	measure 'Commissions Internes M-1' =
			IF (
			    COUNTROWS ( VALUES ( dim_date[annee_mois_key] ) ) = 1,
			    CALCULATE ( [Commissions Internes], DATEADD ( dim_date[full_date], -1, MONTH ) )
			)
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: commissions
		lineageTag: 225fb166-f7be-490d-afaf-2d8c13dbbf5d

	measure 'Evolution Commissions M-1 %' =
			DIVIDE (
			    [Commissions Internes] - [Commissions Internes M-1],
			    [Commissions Internes M-1]
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: commissions
		lineageTag: 3d5e8017-df63-44cc-aae9-3a71dbcdecbe

	measure 'CA TTC M-1' =
			IF (
			    COUNTROWS ( VALUES ( dim_date[annee_mois_key] ) ) = 1,
			    CALCULATE ( [CA TTC], DATEADD ( dim_date[full_date], -1, MONTH ) )
			)
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: Comparaison temporelle
		lineageTag: fc7df60a-2c9f-41e8-888a-70f914a88725

	measure 'Evolution CA TTC M-1 %' = DIVIDE ( [CA TTC] - [CA TTC M-1], [CA TTC M-1] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Comparaison temporelle
		lineageTag: bb027b89-88a0-4015-9af8-5745de213fcc

	measure 'Objectif Nb Ventes' =
			SWITCH (
			    [Niveau Objectif],
			    "CONSEILLER", [Objectif Nb Ventes Conseiller],
			    "AGENCE",     [Objectif Nb Ventes Agence],
			    "PARTENAIRE", [Objectif Nb Ventes Partenaire],

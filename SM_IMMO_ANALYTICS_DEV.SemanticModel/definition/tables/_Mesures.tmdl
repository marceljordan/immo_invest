	measure 'Niveau Objectif' =
			VAR NiveauUtilisateur =
			    MAXX (
			        FILTER (
			            security_user_access,
			            LOWER ( security_user_access[user_email] ) = LOWER ( USERPRINCIPALNAME () )
			                && security_user_access[is_active]
			        ),
			        security_user_access[access_level]
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISFILTERED ( dim_conseiller ), "CONSEILLER",
			        ISFILTERED ( dim_agence_region[agence_id] )
			            || ISFILTERED ( dim_agence_region[nom_agence] )
			            || ISFILTERED ( dim_agence_region[code_agence] ), "AGENCE",
			        ISFILTERED ( dim_partenaire ), "PARTENAIRE",
			        NiveauUtilisateur IN { "CONSEILLER", "AGENCE", "PARTENAIRE" }, NiveauUtilisateur,
			        "REGION"
			    )
		isHidden
		displayFolder: objectifs
		lineageTag: 0a9a426f-74d3-4896-a26f-552072cc8192

